{
  "name": "renderpdf-js",
  "version": "0.5.0",
  "description": "Create PDFs from HTML, images or code, and merge or split existing PDFs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichalekJan93/renderPDF.js.git"
  },
  "homepage": "https://github.com/MichalekJan93/renderPDF.js#readme",
  "bugs": {
    "url": "https://github.com/MichalekJan93/renderPDF.js/issues"
  },
  "keywords": [
    "pdf",
    "html",
    "browser",
    "typescript",
    "html-to-pdf",
    "image-to-pdf",
    "tiff-to-pdf",
    "pdf-generation",
    "pdf-merge",
    "pdf-split"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/index.js",
    "dist/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "API.md",
    "LICENSE",
    "assets/renderpdf-logo.png"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "npm run build:library",
    "build:library": "npm run typecheck && vp build --config vite.library.config.ts && tsc -p tsconfig.build.json",
    "prepack": "npm run build:library && npm run check:package",
    "check:package": "node scripts/check-package.ts",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test",
    "test:browser": "playwright test",
    "test:devextreme": "playwright test --config playwright.devextreme.config.ts",
    "benchmark": "npm run build:library && playwright test --config playwright.benchmark.config.ts",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check && npm test && npm run test:browser && npm run build && npm run check:package"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "html-to-image": "^1.11.13",
    "pdf-lib": "^1.17.1",
    "utif2": "4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "pdfjs-dist": "^6.4.299",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
