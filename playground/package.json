{
  "name": "renderpdf-js-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vp dev --force",
    "build": "tsc --noEmit && vp build",
    "preview": "vp preview",
    "test:browser": "playwright test",
    "test:cross-browser": "playwright test --config playwright.cross-browser.config.ts",
    "check": "vp check && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "pdfjs-dist": "^6.4.299",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "renderpdf-js": "file:../artifacts/renderpdf-js-0.6.0.tgz"
  }
}
